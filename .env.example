# knowledgegraph - LLM provider configuration
#
# Copy this file to `.env` and fill in ONE provider block.
# Any OpenAI-compatible endpoint works. Existing environment variables
# always win over .env values. `.env` is gitignored - never commit keys.

# ---- Option A: OpenRouter (100+ models behind one key) --------------------
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Optional: pin models. Defaults: gpt-4.1-mini for both layers.
OPENAI_MODEL=google/gemini-2.0-flash-001
#KG_SEMANTIC_MODEL=google/gemini-2.0-flash-001
#KG_AGENT_MODEL=google/gemini-2.0-flash-001
# NOTE: models ending in ":free" (e.g. "meta-llama/llama-3.1-8b-instruct:free")
# are rate-limited by free-models-per-day caps - bench runs will 429 mid-run.
# For kg-bench use a paid model (gemini-2.0-flash is ~$0.10/1M input tokens).

# ---- Option B: OpenAI direct -----------------------------------------------
#OPENAI_API_KEY=sk-...
#OPENAI_MODEL=gpt-4.1-mini

# ---- Option C: Groq (very fast, cheap) --------------------------------------
#OPENAI_API_KEY=gsk_your-key-here
#OPENAI_BASE_URL=https://api.groq.com/openai/v1
#OPENAI_MODEL=llama-3.1-8b-instant

# ---- Option D: DeepSeek ------------------------------------------------------
#OPENAI_API_KEY=sk-your-key-here
#OPENAI_BASE_URL=https://api.deepseek.com/v1
#OPENAI_MODEL=deepseek-chat

# ---- Option E: Together AI ----------------------------------------------------
#OPENAI_API_KEY=your-key-here
#OPENAI_BASE_URL=https://api.together.xyz/v1
#OPENAI_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# ---- Option F: fully local (Ollama) - zero cost, no network -------------------
#OPENAI_API_KEY=local
#OPENAI_BASE_URL=http://localhost:11434/v1
#OPENAI_MODEL=qwen2.5-coder:7b

# ---- Pipeline knobs ------------------------------------------------------------
# Output directory (default kg-out)
#KG_OUT=kg-out

# Bench pricing for models not in the built-in table.
# JSON: model-name-prefix -> [USD per 1M input tokens, USD per 1M output tokens]
#KG_PRICE_OVERRIDES={"mistralai/mistral-small": [0.2, 0.6]}
